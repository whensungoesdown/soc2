

# need at least one \n at the begining


# Yes, it is safe to ignore incomplete I/O assignment warning messages in the Quartus® II software, for dual purpose configuration pins that are used for Active Parallel (AP) configuration.
# The current strength and slew rate assignments on these AP configuration pins should be left to default, but this will result in the generation of incomplete I/O assignment warning messages by the Quartus II software related to missing drive strength and slew rate assignments.

set_location_assignment PIN_G1 -to clk
set_location_assignment PIN_E4 -to resetn

set_location_assignment PIN_E15 -to vga_hsync
set_location_assignment PIN_E14 -to vga_vsync
set_location_assignment PIN_C15 -to vga_rgb[0]
set_location_assignment PIN_D15 -to vga_rgb[1]
set_location_assignment PIN_B15 -to vga_rgb[2]


set_location_assignment PIN_P16 -to uart_rx
set_location_assignment PIN_P20 -to uart_tx


set_location_assignment PIN_L7  -to sdram_dq[0]
set_location_assignment PIN_L6  -to sdram_dq[1]
set_location_assignment PIN_M7  -to sdram_dq[2]
set_location_assignment PIN_M6  -to sdram_dq[3]
set_location_assignment PIN_M5  -to sdram_dq[4]
set_location_assignment PIN_M4  -to sdram_dq[5]
set_location_assignment PIN_M3  -to sdram_dq[6]
set_location_assignment PIN_N7  -to sdram_dq[7]
set_location_assignment PIN_R1  -to sdram_dq[8]
set_location_assignment PIN_R2  -to sdram_dq[9]
set_location_assignment PIN_P1  -to sdram_dq[10]
set_location_assignment PIN_P2  -to sdram_dq[11]
set_location_assignment PIN_N1  -to sdram_dq[12]
set_location_assignment PIN_N2  -to sdram_dq[13]
set_location_assignment PIN_M1  -to sdram_dq[14]
set_location_assignment PIN_M2  -to sdram_dq[15]
                                
set_location_assignment PIN_R5  -to sdram_addr[0]
set_location_assignment PIN_T5  -to sdram_addr[1]
set_location_assignment PIN_T4  -to sdram_addr[2]
set_location_assignment PIN_T3  -to sdram_addr[3]
set_location_assignment PIN_V3  -to sdram_addr[4]
set_location_assignment PIN_V4  -to sdram_addr[5]
set_location_assignment PIN_AA1 -to sdram_addr[6]
set_location_assignment PIN_Y1  -to sdram_addr[7]
set_location_assignment PIN_Y2  -to sdram_addr[8]
set_location_assignment PIN_W1  -to sdram_addr[9]
set_location_assignment PIN_R7  -to sdram_addr[10]
set_location_assignment PIN_W2  -to sdram_addr[11]
set_location_assignment PIN_V1  -to sdram_addr[12]

set_location_assignment PIN_P4  -to sdram_ba[0]
set_location_assignment PIN_P3  -to sdram_ba[1]
set_location_assignment PIN_P7  -to sdram_cas_n
set_location_assignment PIN_V2  -to sdram_cke
set_location_assignment PIN_U1  -to sdram_clk
set_location_assignment PIN_P5  -to sdram_cs_n
set_location_assignment PIN_N6  -to sdram_dqm[0]
set_location_assignment PIN_U2  -to sdram_dqm[1]
set_location_assignment PIN_P6  -to sdram_ras_n
set_location_assignment PIN_N5  -to sdram_we_n


set_location_assignment PIN_F16 -to sd_clk_dev
set_location_assignment PIN_B16 -to sd_cs_n
set_location_assignment PIN_H14 -to sd_miso
set_location_assignment PIN_E16 -to sd_mosi
